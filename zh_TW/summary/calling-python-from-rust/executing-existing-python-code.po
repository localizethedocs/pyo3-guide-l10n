#: src/python-from-rust/calling-existing-code.md:305
msgid "Need to use a context manager from Rust?"
msgstr ""

#: src/python-from-rust/calling-existing-code.md:307
msgid "Use context managers by directly invoking `__enter__` and `__exit__`."
msgstr ""

#: src/python-from-rust/calling-existing-code.md:316
msgid ""
"r#\"\n"
"class House(object):\n"
"    def __init__(self, address):\n"
"        self.address = address\n"
"    def __enter__(self):\n"
"        print(f\"Welcome to {self.address}!\")\n"
"    def __exit__(self, type, value, traceback):\n"
"        if type:\n"
"            print(f\"Sorry you had {type} trouble at {self.address}\")\n"
"        else:\n"
"            print(f\"Thank you for visiting {self.address}, come again soon!"
"\")\n"
"\n"
"        \"#"
msgstr ""

#: src/python-from-rust/calling-existing-code.md:329
msgid "\"house.py\""
msgstr ""

#: src/python-from-rust/calling-existing-code.md:330
msgid "\"house\""
msgstr ""

#: src/python-from-rust/calling-existing-code.md:334
msgid "\"House\""
msgstr ""

#: src/python-from-rust/calling-existing-code.md:335
msgid "\"123 Main Street\""
msgstr ""

#: src/python-from-rust/calling-existing-code.md:337
msgid "\"__enter__\""
msgstr ""

#: src/python-from-rust/calling-existing-code.md:339
msgid "\"undefined_variable + 1\""
msgstr ""

#: src/python-from-rust/calling-existing-code.md:341
msgid ""
"// If the eval threw an exception we'll pass it through to the context "
"manager.\n"
"        // Otherwise, __exit__  is called with empty arguments (Python "
"\"None\").\n"
msgstr ""

#: src/python-from-rust/calling-existing-code.md:347
#: src/python-from-rust/calling-existing-code.md:353
